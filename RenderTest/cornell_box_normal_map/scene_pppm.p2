#version 1.1.0;

option(single-frame-render-session) @session = [vector2 frame-size "64 64"] [string visualizer @visualizer] [string observer @observer] [string sample-source @sampler];
observer(single-lens) @observer = [real fov-degrees 50] [vector3 pos "0 0 16"] [vector3 dir "0 0 -1"] [vector3 up-axis "0 1 0"];
sample-source(stratified) @sampler = [integer samples 1];
visualizer(photon-mapping) @visualizer =
    [enum sample-filter bh]
    [enum mode probabilistic-progressive]
    [integer num-passes 256]
    [integer num-photons 20000]
    [real photon-radius 0.3]
    [integer num-samples-per-pixel 1];

#import "cornell_box_normal_map.p2";
