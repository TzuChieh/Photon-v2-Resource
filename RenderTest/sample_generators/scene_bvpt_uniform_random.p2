#version 1.1.0;

option(single-frame-render-session) @session = [vector2 frame-size "1920 1080"] [string visualizer @visualizer] [string observer @observer] [string sample-source @sampler];
observer(single-lens) @observer = [real fov-degrees 90] [vector3 pos "0 0 0"] [vector3 dir "0 0 -1"] [vector3 up-axis "0 1 0"];
sample-source(uniform-random) @sampler = [integer samples 100];
visualizer(path-tracing) @visualizer = [enum sample-filter box] [enum estimator bvpt];

#import "sample_generators_image.p2";