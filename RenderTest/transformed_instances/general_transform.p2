// The unit-cuboid source is hidden and cached for all instances.
geometry(cuboid) @cloudGeometry = [vector3 size "1 1 1"];
material(matte-opaque) @cloudMaterial = [spectrum albedo "0.76 0.3 0.12"];
phantom actor(model) @cloudSource =
    [geometry geometry @cloudGeometry]
    [material material @cloudMaterial]
    [bool is-instantiable-hint true];

// A large overhead emitter illuminates the randomly oriented cloud.
actor(rectangle-light) @topLight =
    [real width 24]
    [real height 24]
    [spectrum color "0.94 0.97 1"]
    [real watts 26000];
translate(@topLight) = [vector3 amount "0 18 0"];
rotate(@topLight) = [vector3 axis "1 0 0"] [real degrees 90];

