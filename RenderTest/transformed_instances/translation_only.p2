// The 0.84 x 2.6 x 0.84 cuboid source is hidden and cached for all instances.
geometry(cuboid) @heightGeometry = [vector3 size "0.84 2.6 0.84"];
material(matte-opaque) @heightMaterial = [spectrum albedo "0.24 0.54 0.72"];
phantom actor(model) @heightSource =
    [geometry geometry @heightGeometry]
    [material material @heightMaterial]
    [bool is-instantiable-hint true];

// A broad overhead emitter gives BNEEPT a large target and keeps this render inexpensive.
actor(rectangle-light) @topLight =
    [real width 34]
    [real height 34]
    [spectrum color "1 0.96 0.9"]
    [real watts 45000];
translate(@topLight) = [vector3 amount "0 22 0"];
rotate(@topLight) = [vector3 axis "1 0 0"] [real degrees 90];

